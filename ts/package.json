{
  "name": "@anomaorg/pa-solana-client",
  "version": "0.8.0",
  "description": "Client bindings for the Solana Anoma Protocol Adapter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anoma/anoma-pa-solana-client"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "copy-data": "mkdir -p src/data && cp ../rust/idls/protocol_adapter.json ../rust/deployments.json src/data/",
    "prepare": "npm run copy-data",
    "prebuild": "npm run copy-data",
    "build": "tsc",
    "pretsc": "npm run copy-data",
    "tsc": "tsc -p tsconfig.test.json",
    "pretest": "npm run copy-data",
    "test": "vitest run --project unit",
    "pretest:deployed": "npm run copy-data",
    "test:deployed": "vitest run --project deployed"
  },
  "dependencies": {
    "@anchor-lang/core": "^2.0.0-rc.2",
    "@noble/hashes": "^1.8.0",
    "@solana/kit": "^8.5.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
